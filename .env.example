# ========================================================
# JIMISCOUT BTP — ENVIRONMENT CONFIGURATION (.env.example)
# ========================================================

# 1. Owner Access Control & Webhook Security
JIMISCOUT_ADMIN_TOKEN="replace-with-strong-owner-access-token"
WEBHOOK_SECRET="replace-with-webhook-hmac-secret"

# 2. Application URL & Timezone
APP_URL="https://jimy-scout.vercel.app"
NEXT_PUBLIC_APP_URL="https://jimy-scout.vercel.app"
TIMEZONE="Europe/Zurich"

# 3. Supabase (PostgreSQL Authoritative Database)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Set true in non-Railway cloud runtimes. Railway enables this guard automatically.
JIMISCOUT_REQUIRE_CLOUD_STORAGE=true
# Local UI development only: disables both automatic and manual discovery/outreach.
JIMISCOUT_SAFE_PREVIEW=true

# 4. Google Gemini AI (Reply Triage & Business Card OCR)
GEMINI_API_KEY="your-gemini-api-key"

# 4b. Google Places API (New) — autonomous contractor discovery
# Enable Places API (New) and restrict this key to the Places API.
GOOGLE_PLACES_API_KEY="your-google-places-api-key"
FOURSQUARE_API_KEY="your-foursquare-api-key"
# Optional: use a managed Overpass endpoint for OpenStreetMap discovery.
OSM_OVERPASS_URL=""
# Optional: Zefix registry credentials for Swiss legal-entity verification.
ZEFIX_USERNAME=""
ZEFIX_PASSWORD=""

# 5. Outbound SMTP (Infomaniak / Google Workspace)
SMTP_HOST="mail.infomaniak.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="info@jimyexport.ch"
SMTP_PASS="your-smtp-device-password"

# 6. Inbound IMAP Poller
IMAP_HOST="mail.infomaniak.com"
IMAP_PORT=993
IMAP_USER="info@jimyexport.ch"
IMAP_PASS="your-imap-device-password"

# 7. Telegram Bot Push Notifications
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CLIENT_CHAT_ID="your-telegram-chat-id"

# 8. Optional Redis Queue (BullMQ Worker Daemon)
REDIS_URL="redis://default:password@your-redis-host:6379"
